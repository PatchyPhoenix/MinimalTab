{
    "name": "MinimalTab",
    "version": "1.11.0",
    "description": "A stunning minimalistic custom new tab",
    "manifest_version": 3,
    "author": "patchyphoenix",
    "action":{
        "default_title": "MinimalTab"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions":[
        "storage",
        "sidePanel",
        "tabs",
        "favicon",
        "webRequest",
        "<all_urls>"
    ],
    "web_accessible_resources":[{
        "resources":["_favicon/*"],
        "matches": ["<all_urls>"],
        "extension_ids":["*"],
        "use_dynamic_url": false
        }],
    "content_scripts": [
        {
            "matches": ["https://minmaltab.web.app/*"],
            "js": ["scripts/content.js"]
        }
    ],
    "side_panel":{
        "default_path":"settings/index.html"
    },
    "icons": {
        "16": "resources/logo.png",
        "32": "resources/logo32.png",
        "64": "resources/logo64.png",
        "128": "resources/logo128.png"
    },
    "version_name": "1.11",
    "background": {
        "service_worker": "scripts/service-worker.js"
    },    
    "host_permissions": ["<all_urls>"],
    "key": ""
}