{
    "name": "MinimalTab",
    "version": "1.10",
    "description": "A stunning minimalistic custom new tab",
    "manifest_version": 3,
    "author": "patchyphoenix",
    "action":{
        "default_title": "MinimalTab"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions":[
        "storage",
        "tabs"
    ],
    "web_accessible_resources":[{
        "resources":["_favicon/*"],
        "matches": ["<all_urls>"],
        "extension_ids":["*"]
        }],
    "icons": {
        "16": "resources/logo.png",
        "32": "resources/logo32.png",
        "64": "resources/logo64.png",
        "128": "resources/logo128.png"
    }
}